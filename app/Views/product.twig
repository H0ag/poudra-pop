<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>POUDRA-POP</title>

    {% include "inc/referencement.twig" %}

    <link rel="stylesheet" href="/assets/css/base.css">
    <link rel="stylesheet" href="/assets/css/product.css">
    <script defer src="/assets/js/product.js"></script>

    <!-- Analytics poudra-pop -->
    <script async="" defer="" src="https://analytics.msallon.org/script.js" data-website-id="352f4853-e053-484f-9d0a-44a2bc88d212" data-domains="poudra-pop.msallon.org"></script>
</head>
<body>
    <main id="main-container">
        <header>
            <img alt="POUDRA-POP logo" src="/assets/images/logo-ours.png">
        </header>
        <marquee scrollamount="10" direction="left" class="poudra-marquee">🌈🍬🍭 POUDRA-POP !!! POUDRA-POP !!! POUDRA-POP !!! 🍭🍬🌈  ACHÈTE TON KIT "OURS HIBERNATUS" ET RESTE ÉVEILLÉ JUSQU'EN 2028 !!! ✨ NE PAS RENIFLER LA POUDRE (WINK WINK) ! 🧸🔥 &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;🌈🍬🍭 POUDRA-POP !!! POUDRA-POP !!! POUDRA-POP !!! 🍭🍬🌈  ACHÈTE TON KIT "OURS HIBERNATUS" ET RESTE ÉVEILLÉ JUSQU'EN 2028 !!! ✨ NE PAS RENIFLER LA POUDRE (WINK WINK) ! 🧸🔥 &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;🌈🍬🍭 POUDRA-POP !!! POUDRA-POP !!! POUDRA-POP !!! 🍭🍬🌈  ACHÈTE TON KIT "OURS HIBERNATUS" ET RESTE ÉVEILLÉ JUSQU'EN 2028 !!! ✨ NE PAS RENIFLER LA POUDRE (WINK WINK) ! 🧸🔥 &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</marquee>
        {% include "inc/navbar.twig" %}
        <div id="container">
            {% include "inc/sidebar.twig" %}
            <div id="container-right" class="product-page-layout">
                <div class="product-visuals">
                    <div class="main-image-container">
                        <img id="main-product-image" src="/item/thumbnail/{{ item.id }}/0?size=600" alt="{{ item.name }}">
                        {% if item.is_best_seller %}
                            <div class="badge-best-seller">TOP VENTE</div>
                        {% endif %}
                    </div>
                    <div class="image-thumbnails">
                        <button class="thumb-btn active" onclick="changeImage('/item/thumbnail/{{ item.id }}/0?size=600', this)">
                            <img src="/item/thumbnail/{{ item.id }}/0?size=100" alt="Pixel Art">
                        </button>
                        <button class="thumb-btn" onclick="changeImage('/item/thumbnail/{{ item.id }}/1?size=600', this)">
                            <img src="/item/thumbnail/{{ item.id }}/1?size=100" alt="Realistic">
                        </button>
                    </div>
                </div>

                <div class="product-details">
                    <header class="product-header">
                        <h1 class="small-text">{{ item.name }}</h1>
                        <div class="product-meta">
                            <span class="product-price">{{ item.price|number_format(2, ',', ' ') }}€</span>
                        </div>
                        <p class="product-ref">Référence : <strong>{{ item.reference }}</strong></p>
                    </header>

                    <section class="product-info-grid">
                        <div class="info-card">
                            <h3><i class="icon">✨</i> EFFET</h3>
                            <p>{{ item.effect }}</p>
                        </div>

                        <div class="info-row">
                            <div class="info-item">
                                <span class="label">Saveur :</span>
                                <span class="value">{{ item.flavor }}</span>
                            </div>
                            <div class="info-item">
                                <span class="label">Composition :</span>
                                <span class="value">{{ item.composition }}</span>
                            </div>
                        </div>
                    </section>

                    <div class="purchase-zone">
                        <div class="quantity-selector">
                            <button onclick="this.parentNode.querySelector('input').stepDown()">-</button>
                            <input type="number" value="1" min="1">
                            <button onclick="this.parentNode.querySelector('input').stepUp()">+</button>
                        </div>
                        <button class="btn-add-to-cart">
                            AJOUTER AU PANIER
                        </button>
                    </div>
                </div>
            </div>

            <script>
            /**
            * Changes the main product image and updates the active thumbnail state
            * @param {string} src - The source URL of the image
            * @param {HTMLElement} btn - The clicked thumbnail button
            */
            function changeImage(src, btn) {
                document.getElementById('main-product-image').src = src;
                const thumbs = document.querySelectorAll('.thumb-btn');
                thumbs.forEach(t => t.classList.remove('active'));
                btn.classList.add('active');
            }
            </script>
        </div>
        {% include "inc/tutorial.twig" %}
    </main>
</body>
</html>