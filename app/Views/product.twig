        <nav id="navbar">
            <ul>
                <li><a href="/">🏠 Accueil</a></li>
                <li><a href="/catalogue">🍭 Catalogue</a></li>
                <li><a href="/cart">🛒 Panier</a></li>
                <li><a href="/login">👤 Compte</a></li>
            </ul>
        </nav>
        <div id="container">
            <div id="container-left">
                <div class="left-items-container">
                    <div class="left-items-container-text small-text">
                        <p>notre</p>
                        <p>mascotte POP</p>
                    </div>
                    <img src="/assets/images/pop-welcome.webp" alt="Macotte pop" class="not-selectable-img">
                </div>
                <div class="left-items-container">
                    <img src="/assets/images/paiements-poudra-pop.png" alt="Paiements Poudra-pop" class="not-selectable-img">
                </div>
            </div>
            <div id="container-right">
                <div id="container-item-left">
                    {# <img src="/assets/images/products/coco-caline.webp" /> #}
                    <div class="item-thumbnail" id="zoom-trigger">
                        <div class="floor-wrapper">
                            <div class="poudra-floor"></div>
                        </div>
                        <img alt="Product thumbnail 1" src="/assets/images/products/coco-caline-pic.webp" class="image-bottom" id="target-img">
                        <img alt="Product thumbnail 2" src="/assets/images/products/coco-caline.webp" class="image-top">
                    </div>
                    <dialog id="lightbox">
                        <div class="lightbox-content">
                            <img src="" alt="Coco caline image" id="lightbox-img">
                            <button id="close-lightbox">Close</button>
                        </div>
                    </dialog>
                </div>
                <div id="container-item-right">
                    <h1 id="product-item-title" class="big-text">coco-caline 😉</h1>
                    <p id="product-item-price"><strong>17.90€</strong></p>
                    <p style="margin:0;">En stock</p>
                    <p>R&eacute;f: CC-CLN-001</p>
                    <button class="btn-add-cart">
                        AJOUTER AU PANIER
                    </button>
                </div>
            </div>
        </div>
        {% include "inc/tutorial.twig" %}
