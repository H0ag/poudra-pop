</head>
<body>
    <main id="main-container">
        <header>
            <img alt="POUDRA-POP logo" src="/assets/images/logo-ours.png">
        </header>
        <marquee scrollamount="10" direction="left" class="poudra-marquee">🌈🍬🍭 POUDRA-POP !!! POUDRA-POP !!! POUDRA-POP !!! 🍭🍬🌈  ACHÈTE TON KIT "OURS HIBERNATUS" ET RESTE ÉVEILLÉ JUSQU'EN 2028 !!! ✨ NE PAS RENIFLER LA POUDRE (WINK WINK) ! 🧸🔥 &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;🌈🍬🍭 POUDRA-POP !!! POUDRA-POP !!! POUDRA-POP !!! 🍭🍬🌈  ACHÈTE TON KIT "OURS HIBERNATUS" ET RESTE ÉVEILLÉ JUSQU'EN 2028 !!! ✨ NE PAS RENIFLER LA POUDRE (WINK WINK) ! 🧸🔥 &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;🌈🍬🍭 POUDRA-POP !!! POUDRA-POP !!! POUDRA-POP !!! 🍭🍬🌈  ACHÈTE TON KIT "OURS HIBERNATUS" ET RESTE ÉVEILLÉ JUSQU'EN 2028 !!! ✨ NE PAS RENIFLER LA POUDRE (WINK WINK) ! 🧸🔥 &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</marquee>
        {% include "inc/navbar.twig" %}
        <div id="container">
            {% include "inc/sidebar.twig" %}
            <div id="container-right">
                <div id="home-banner-container">
                    <img src="/assets/images/home-banner.webp" alt="Poudra-pop home banner" id="home-banner-banner" class="not-selectable-img">
                    <div id="home-banner" class="big-text"> 
                        <p>tableau de bord</p>
                        <p>de ton espace VIP</p>
                    </div>
                </div>
                <h1 class="big-text">REGARDE 👀 TES INFOS 📊🔥</h1>
                <div class="input-block">
                    <label for="info-email">Adresse Electronique.</label>
                    <input class="poudrapop-input" name="info-email" placeholder="Adresse Electronique" value="{{ session.user.email }}" disabled/>
                </div>
                <div class="input-block">
                    <label for="info-name">Pseudonyme.</label>
                    <input class="poudrapop-input" name="info-name" placeholder="Pseudonyme" value="{{ session.user.name }}" disabled/>
                </div>
                <div class="input-block">
                    <label for="info-avatar">Avatar.</label>
                    <img src="{{ session.user.avatar }}" width="50"/>
                    <input class="poudrapop-input" name="info-avatar" placeholder="Avatar" value="{{ session.user.avatar }}" disabled/>
                </div>
            </div>
        </div>
        {% include "inc/tutorial.twig" %}
    </main>
</body>
</html>